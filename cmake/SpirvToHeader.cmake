# Converts a compiled SPIR-V binary into a C header containing a byte array.
#
# Usage (from CMake custom commands):
#   cmake -DIN=<file.spv> -DOUT=<file.h> -DNAME=<symbol> -P SpirvToHeader.cmake

if(NOT DEFINED IN OR NOT DEFINED OUT OR NOT DEFINED NAME)
    message(FATAL_ERROR "SpirvToHeader requires -DIN, -DOUT and -DNAME")
endif()

file(READ "${IN}" _hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _array "${_hex}")

get_filename_component(_name_we "${IN}" NAME_WE)

file(WRITE "${OUT}"
"// Generated by cmake/SpirvToHeader.cmake from ${IN}. Do not edit.
// SPIR-V binary for ${_name_we}.

static const unsigned char ${NAME}[] = {
${_array}};
static const size_t ${NAME}_size = sizeof(${NAME});
")
